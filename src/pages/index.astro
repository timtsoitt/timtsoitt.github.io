---
import Base from "../layouts/Base.astro";
import ArticleList from "../components/ArticleList.astro";
import { getArticles } from "../lib/articles";
const articles = await getArticles();
---

<Base>
  <p class="home-mobile-intro">
    I’m Tim, an engineer based in Japan.{" "}
    <a class="text-link" href="/about/">
      About me <span aria-hidden="true">↗</span>
    </a>
  </p>
  <div class="home-layout">
    <section class="writing-section" aria-labelledby="writing-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">FROM THE NOTEBOOK</p>
          <h1 id="writing-title">
            Recent writing<span class="accent-period">.</span>
          </h1>
        </div>
        <a class="text-link" href="/articles/">
          All articles <span aria-hidden="true">↗</span>
        </a>
      </div>
      <ArticleList articles={articles.slice(0, 3)} />
    </section>
    <aside class="home-about" aria-labelledby="intro-title">
      <p class="eyebrow" id="intro-title">
        ABOUT ME
      </p>
      <p class="home-about-description">
        I work across software, infrastructure, and security, so I’ve never fit
        neatly into one engineering title.
      </p>
      <p class="home-about-description">
        Member of Technical Staff feels about right—a little broad, but so is my
        day job.
      </p>
      <a class="text-link" href="/about/">
        More about me <span aria-hidden="true">↗</span>
      </a>
    </aside>
  </div>
</Base>
