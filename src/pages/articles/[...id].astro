---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import ViewCount from "../../components/ViewCount.astro";
import { getArticles, formatDate, readingTime } from "../../lib/articles";

export async function getStaticPaths() {
  return (await getArticles()).map((article) => ({
    params: { id: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);
const contents = headings.filter(({ depth }) => depth === 2 || depth === 3);
---

<Base title={article.data.title} description={article.data.description} article>
  <article class="post">
    <header class="post-header">
      <div class="post-header-copy">
        <a class="text-link back-link" href="/articles/">
          ← All writing
        </a>
        <div class="article-meta">
          <time datetime={article.data.date.toISOString()}>
            {formatDate(article.data.date)}
          </time>
          <span>·</span>
          <span>{readingTime(article.body)} min read</span>
          <ViewCount />
        </div>
        <h1>{article.data.title}</h1>
        <p class="post-description">{article.data.description}</p>
        <div class="tags">
          {article.data.tags.map((tag: string) => (
            <span>{tag}</span>
          ))}
        </div>
      </div>
    </header>
    {contents.length > 0 && (
      <aside class="toc">
        <nav aria-label="Table of contents">
          <p class="eyebrow">ON THIS PAGE</p>
          <ul>
            {contents.map((heading) => (
              <li class:list={{ nested: heading.depth === 3 }}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>
    )}
    <div class="post-layout">
      <div class="prose">
        <Content />
      </div>
    </div>
    <div class="post-end">
      <span>Thanks for reading.</span>
      <a class="text-link" href="/articles/">
        Back to the notebook ↗
      </a>
    </div>
  </article>
</Base>
