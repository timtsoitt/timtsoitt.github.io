---
import "../styles/global.css";
import { site } from "../site";

interface Props {
  title?: string;
  description?: string;
  article?: { date: Date; tags: string[] };
  noindex?: boolean;
}
const {
  title,
  description = site.description,
  article,
  noindex = false,
} = Astro.props;
const pageTitle = title
  ? `${title} — ${site.title}`
  : `${site.name} — ${site.title}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const home = new URL("/", Astro.site).href;
const authorUrl = new URL("/about/", Astro.site).href;
const author = {
  "@type": "Person",
  "@id": `${home}#author`,
  name: site.name,
  url: authorUrl,
  sameAs: [site.github, site.linkedin],
};
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    author,
    {
      "@type": "WebSite",
      "@id": `${home}#website`,
      url: home,
      name: site.title,
      description: site.description,
      inLanguage: "en",
      author: { "@id": author["@id"] },
    },
    {
      "@type":
        path === "/about/"
          ? "ProfilePage"
          : path === "/articles/"
            ? "CollectionPage"
            : "WebPage",
      "@id": `${canonical.href}#webpage`,
      url: canonical.href,
      name: pageTitle,
      description,
      inLanguage: "en",
      isPartOf: { "@id": `${home}#website` },
      ...(path === "/about/" && { mainEntity: { "@id": author["@id"] } }),
    },
    ...(article
      ? [
          {
            "@type": "BlogPosting",
            "@id": `${canonical.href}#article`,
            url: canonical.href,
            headline: title,
            description,
            datePublished: article.date.toISOString(),
            author,
            inLanguage: "en",
            keywords: article.tags,
            mainEntityOfPage: { "@id": `${canonical.href}#webpage` },
            isPartOf: { "@id": `${home}#website` },
          },
        ]
      : []),
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#f8f7f3" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.title}
      href="/rss.xml"
    />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:locale" content="en_US" />
    {article && (
      <>
        <meta
          property="article:published_time"
          content={article.date.toISOString()}
        />
        <meta property="article:author" content={authorUrl} />
        {article.tags.map((tag) => (
          <meta property="article:tag" content={tag} />
        ))}
      </>
    )}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {!noindex && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")}
      />
    )}
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header wrap">
      <a class="wordmark" href="/" aria-label={`${site.title} home`}>
        <span class="brand-icon" aria-hidden="true">
          t.
        </span>{" "}
        {site.title}
        <span class="brand-dot" aria-hidden="true">
          ●
        </span>
      </a>
      <nav aria-label="Main navigation">
        <a
          href="/articles/"
          aria-current={path.startsWith("/articles") ? "page" : undefined}
        >
          Writing
        </a>
        <a
          href="/about/"
          aria-current={path.startsWith("/about") ? "page" : undefined}
        >
          About
        </a>
        <a class="github-link" href={site.github}>
          GitHub <span aria-hidden="true">↗</span>
        </a>
      </nav>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="site-footer wrap">
      <div>
        <a class="footer-name" href="/">
          {site.title}
        </a>
        <p>A little corner of the internet. Built with curiosity.</p>
      </div>
      <div class="footer-links">
        <a href="/rss.xml">RSS feed ↗</a>
        <a href={site.github}>GitHub ↗</a>
        <span>
          © {new Date().getFullYear()} {site.name}
        </span>
      </div>
    </footer>
    {import.meta.env.PROD && <script
      is:inline
      define:vars={{ publicHost: canonical.hostname }}
    >
      // Keep local development and preview visits out of analytics.
      if (window.location.hostname === publicHost) {
        const analytics = document.createElement("script");
        analytics.async = true;
        analytics.src = "https://gc.zgo.at/count.js";
        analytics.setAttribute(
          "data-goatcounter",
          "https://timtsoitt.goatcounter.com/count",
        );
        document.body.appendChild(analytics);

        const counter = document.querySelector("[data-view-path]");
        if (counter) {
          const path = counter.getAttribute("data-view-path");
          fetch(
            "https://timtsoitt.goatcounter.com/counter/" +
              encodeURIComponent(path) +
              ".json",
            {
              credentials: "omit",
              signal: AbortSignal.timeout(8000),
            },
          )
            .then((response) => {
              if (!response.ok) throw new Error("View count unavailable");
              return response.json();
            })
            .then((data) => {
              if (typeof data.count !== "string" || !data.count.trim()) return;
              counter.textContent = data.count + " views";
              counter.hidden = false;
            })
            .catch(() => {
              /* Keep unavailable counts hidden. */
            });
        }
      }
    </script>}
  </body>
</html>
